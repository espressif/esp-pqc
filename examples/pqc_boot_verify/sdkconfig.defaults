# Disable DS peripheral — mbedtls/rsa.h missing in tf-psa-crypto mbedTLS
CONFIG_ESP_TLS_USE_DS_PERIPHERAL=n
CONFIG_MBEDTLS_HARDWARE_RSA_DS_PERIPHERAL=n

# --- Secure Boot V2 (ECDSA) ---
CONFIG_SECURE_BOOT=y
CONFIG_SECURE_BOOT_V2_ENABLED=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_INSECURE=y
CONFIG_SECURE_BOOT_FLASH_BOOTLOADER_DEFAULT=y
# --- Flash Encryption ---
CONFIG_SECURE_FLASH_ENC_ENABLED=y
CONFIG_SECURE_FLASH_ENCRYPTION_MODE_DEVELOPMENT=y

# --- ROM Download Mode (allow for both secure boot & flash encryption) ---
CONFIG_SECURE_INSECURE_ALLOW_DL_MODE=y
CONFIG_SECURE_FLASH_UART_BOOTLOADER_ALLOW_ENC=y

# --- JTAG (potentially insecure option) ---
CONFIG_SECURE_BOOT_ALLOW_JTAG=y

# --- NVS Encryption disabled ---
# CONFIG_NVS_ENCRYPTION is not set

# --- Partition table (single-app, offset bumped to leave room for the bootloader) ---
CONFIG_PARTITION_TABLE_SINGLE_APP=y
CONFIG_PARTITION_TABLE_OFFSET=0x14000

# --- liboqs: only ML-DSA enabled ---
CONFIG_LIBOQS_ENABLED=y
CONFIG_LIBOQS_ENABLE_SIG_ML_DSA=y
CONFIG_LIBOQS_ENABLE_KEM_ML_KEM=n
CONFIG_LIBOQS_ENABLE_KEM_BIKE=n
CONFIG_LIBOQS_ENABLE_KEM_FRODOKEM=n
CONFIG_LIBOQS_ENABLE_KEM_NTRUPRIME=n
CONFIG_LIBOQS_ENABLE_KEM_CLASSIC_MCELIECE=n
CONFIG_LIBOQS_ENABLE_KEM_HQC=n
CONFIG_LIBOQS_ENABLE_KEM_KYBER=n
CONFIG_LIBOQS_ENABLE_SIG_FALCON=n
CONFIG_LIBOQS_ENABLE_SIG_SPHINCS=n
CONFIG_LIBOQS_ENABLE_SIG_MAYO=n
CONFIG_LIBOQS_ENABLE_SIG_CROSS=n
CONFIG_LIBOQS_ENABLE_SIG_UOV=n
CONFIG_LIBOQS_ENABLE_SIG_SNOVA=n
